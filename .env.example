# Copy to .env and fill in. See README.md "Setup" for details.

# Postgres connection used by the Next.js app and the worker.
DATABASE_URL=postgres://codepulse:codepulse@localhost:5433/codepulse

# Separate database used only by integration tests (tests truncate freely).
DATABASE_URL_TEST=postgres://codepulse:codepulse@localhost:5433/codepulse_test

# GitHub ingestion. Token needs only public_repo (or repo, for a private repo) read access.
# Point GITHUB_REPO at any repo you want to ingest -- your own, or a small public one.
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# How often the worker polls for ingestion/correlation work, in milliseconds.
WORKER_POLL_INTERVAL_MS=5000

# Port the Next.js app listens on.
PORT=3000
